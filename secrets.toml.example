# Local: copy to secrets.toml in this folder, or set env vars.
# Streamlit Cloud: App settings → Secrets (no file needed).

PAPER_PASSWORD = "change-me"

# Supabase → Project Settings → Database → URI → Transaction pooler (6543)
SUPABASE_DB_URL = "postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
